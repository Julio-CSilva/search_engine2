# =====================================================================
# Example environment file for the search_engine tools.
# Copy this file to ".env" (at the repo root) and fill in your values:
#
#     cp .env.example .env
#
# The real ".env" is git-ignored and must NEVER be committed.
# =====================================================================

# --- NCBI / Entrez ---------------------------------------------------
# Contact e-mail required by NCBI for all Entrez requests.
ENTREZ_EMAIL="you@example.com"

# Optional NCBI API key. Raises the rate limit from 3 to 10 requests/second.
# Create one at https://www.ncbi.nlm.nih.gov/account/settings/
# Leave empty if you don't have one.
ENTREZ_API_KEY=""

# --- Input files (one taxon/ID per line) -----------------------------
# Path to the species list (used by SearchCompleteGenome & SearchBOLDSystems_COI).
species_list_txt="samples/Species_list.txt"

# Path to the SRA accession list (used by Search_Infotable).
sra_list_orderby_nameSpecies_az_txt="samples/SRA_list_orderby_nameSpecies_az.txt"

# --- Output ----------------------------------------------------------
# Base directory where result tables are written. Defaults to "results".
PATH_RESULTS="results"

# Optional output directory override for Search-Engine/searchSRA.R.
# Defaults to "results".
SEARCH_ENGINE_DIR="results"
